/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; frame-src https:; form-action 'self' https://wa.me; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/print/*
  Cache-Control: public, max-age=31536000, immutable

/assets/shots/*
  Cache-Control: public, max-age=31536000, immutable

# ملفات الكود: يتحقق المتصفح منها في كل زيارة، فلا يبقى الزائر على نسخة قديمة بعد النشر
/assets/app.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/style.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/boot.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/print.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: public, max-age=300

/
  Cache-Control: public, max-age=0, must-revalidate
